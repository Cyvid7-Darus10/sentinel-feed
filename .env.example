# Copy to .env.local and fill in. Never commit .env.local.

# Required. Vercel Blob storage token. Auto-provisioned when you link the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Required. Bearer token the cron routes check before doing anything.
# Generate one with: openssl rand -base64 32
CRON_SECRET=change-me-use-openssl-rand-base64-32

# Optional. Without it, stories are stored but never summarized.
ANTHROPIC_API_KEY=sk-ant-xxxx

# Optional. Set to "false" to skip the model call entirely. Defaults to on.
ENABLE_AI_ENRICHMENT=true
